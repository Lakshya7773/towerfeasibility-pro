# ============================================================
#  TowerFeasibility Pro — repository ignores
# ============================================================

# ---- OS / editor cruft ----
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/

# ---- Secrets & signing material (NEVER commit) ----
*.keystore
*.jks
*.p8
*.p12
*.pem
*.key
.env
.env.*
!.env.example
local.properties
google-services.json
# Exception: the standard Android DEBUG keystore is public (password "android")
# and is required for an out-of-the-box `./gradlew assembleDebug`. The RELEASE
# keystore stays excluded above.
!app/android/app/debug.keystore

# ---- Python (data pipeline) ----
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- Node / JS (app) ----
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.tsbuildinfo
.expo/

# ---- Gradle / Android build outputs ----
.gradle/
build/
.cxx/
captures/
*.jsbundle
app/android/app/src/main/java/inline/

# ---- Build outputs: APKs are release artifacts, not source ----
# Rebuild with: cd app/android && ./gradlew assembleRelease
dist/*.apk
dist/_withdrawn/
dist/packs/

# ---- Raw / intermediate upstream datasets (multi-GB) ----
# Regenerated by data-pipeline/scripts/fetch_*.sh + process_*.py.
# app/assets/packs/ (the shipped data pack) IS tracked so the app builds
# and runs out of the box.
data/raw/
data/fiber/
data/towers/
data/basemap/
data/population/
data/soil/
data/admin/
# elevation: keep the small processing-metadata JSON (test_trustworthiness.py
# reads it); the 79 MB GeoTIFF and raw tiles stay ignored.
data/elevation/*
!data/elevation/processed/
data/elevation/processed/*
!data/elevation/processed/*.json

# ---- Local QA scratch / logs ----
qa/
*.log
